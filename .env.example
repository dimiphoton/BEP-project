# Mots de passe de démonstration locale. Ne pas réutiliser ailleurs.
POSTGRES_HOST=localhost
# 5432 par défaut. Si un Postgres local occupe déjà ce port, change la valeur.
POSTGRES_PORT=5432
POSTGRES_DB=observatory
POSTGRES_USER=observatory
POSTGRES_PASSWORD=local_demo_only

INGEST_USER=ingest_rw
INGEST_PASSWORD=local_demo_ingest

DBT_USER=dbt_rw
DBT_PASSWORD=local_demo_dbt

READER_USER=reader_ro
READER_PASSWORD=local_demo_reader
